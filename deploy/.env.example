# 生产部署环境变量示例（复制为 .env 后编辑）
# 注意：本文件可能包含真实密钥，禁止提交到版本库（已在 .dockerignore 中排除）。

# PostgreSQL（必填）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=drission_book
DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/drission_book

# Master 密钥（必填：示例弱密钥会被拒绝启动，见第 13.6 节）
MASTER_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES__openssl_rand_base64_48
MASTER_FIELD_KEY=CHANGE_ME_32_BYTES_BASE64_KEY================

# 站点地址（必填：管理后台对外域名，会下发给 Worker）
MASTER_SITE_BASE=https://admin.example.com

# mTLS 强制（生产保持 1）
MASTER_REQUIRE_CLIENT_CERT=1

# 会话 Cookie Secure（生产保持 1）
MASTER_COOKIE_SECURE=1

# 可信反向代理网段（Docker 内网；X-Forwarded-For 只信任这些地址）
MASTER_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Webshare API Key（留空则禁用同步）
WEBSHARE_API_KEY=

# 两个公网入口域名（必填，见 deploy/Caddyfile）
ADMIN_DOMAIN=admin.example.com
WORKER_DOMAIN=worker.example.com
