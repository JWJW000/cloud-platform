# 云端 Master 公网入口。
#
# ADMIN_DOMAIN：管理后台/API。
# WORKER_DOMAIN：Worker 的唯一 gRPC 地址；首次注册允许无客户端证书，
# OpenLink 再由 Master 强制校验证书指纹、节点令牌和批准状态。

{
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    # HTTP 强制跳转 HTTPS
    redir https://{host}{uri} permanent
}

# ---------------------------------------------------------------- 管理后台入口
{$ADMIN_DOMAIN:admin.example.com} {
    encode gzip

    handle /api/* {
        reverse_proxy master:8080
    }

    handle {
        reverse_proxy master:8080
    }
}

# ---------------------------------------------------------------- Worker 单地址 gRPC 入口
{$WORKER_DOMAIN:worker.example.com} {
    # 首次 RegisterNode/WatchRegistration 尚无证书，因此只能请求证书，不能在
    # TLS 握手阶段强制。OpenLink 的强认证由 Master 按 RPC 方法完成。
    tls {
        client_auth {
            mode request
            trust_pool file {
                pem_file /app/data/ca.crt
            }
        }
    }

    @grpc_worker {
        path /platform.worker.v1.WorkerLink/Enroll* /platform.worker.v1.WorkerLink/RegisterNode* /platform.worker.v1.WorkerLink/WatchRegistration* /platform.worker.v1.WorkerLink/OpenLink*
    }
    handle @grpc_worker {
        reverse_proxy h2c://master:9443 {
            # header_up 的 set 操作会覆盖公网请求携带的同名头，不能再同时配置
            # delete；Caddy 会在 set 之后应用 delete，导致真实指纹也被删除。
            # Caddy 的 fingerprint 占位符本身就是客户端证书 DER 的 SHA-256；
            # 不存在 `.sha256` 后缀，使用该后缀会得到空值并让 Master 误判为缺证书。
            header_up x-client-cert-fingerprint {http.request.tls.client.fingerprint}
        }
    }

    handle {
        respond 404 "not found"
    }
}
